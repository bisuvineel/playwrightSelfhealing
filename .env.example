# Copy to .env and fill in. .env is gitignored.

# --- Healing ---------------------------------------------------------------
HEALER_ENABLED=true
# anthropic | openai | gemini | ollama
HEALER_PROVIDER=anthropic
# Minimum confidence (0-1) a suggested locator must have to be used
HEALER_THRESHOLD=0.7
# Retries per failing action (0-10)
HEALER_MAX_RETRIES=2
# Per-healing-request timeout in ms (1000-600000)
HEALER_TIMEOUT=30000

# Reuse a selector that already healed in this worker instead of asking the
# provider again. A stale selector normally lives in a shared page object, so the
# same rot is otherwise paid for once per test that touches it — this repo's demo
# heals five distinct selectors eleven times, and the cache takes it to five.
#
# Reused selectors are re-validated and re-intent-checked against the live page,
# so a reuse that is wrong there is rejected and a normal heal follows. It
# changes cost, not outcomes. Turn it off to make every heal go to the model.
# HEALER_CACHE=true

# --- Spend controls --------------------------------------------------------
#
# Heals that may reach the provider, per WORKER. Playwright workers are separate
# processes, so the effective ceiling for a run is this times your `workers`
# setting. Cached reuses cost nothing and do not count. 0 removes the ceiling.
# Once reached, further heals are skipped and annotated — cached selectors still
# apply, so the worker keeps using what it already learned.
# HEALER_MAX_HEALS=100

# Consecutive provider failures before this worker stops calling out. With the
# provider unreachable, every failing action otherwise waits
# HEALER_TIMEOUT x HEALER_MAX_RETRIES before giving up, so a five-minute suite
# becomes an hour and fails anyway. Counted in attempts. 0 disables it.
# A low-confidence answer is NOT a failure — the provider is working fine.
# HEALER_BREAKER_THRESHOLD=5

# --- The records file ------------------------------------------------------
#
# healing-records.json is the one place the healed selector is kept UNREDACTED, so
# it is what you read when HEALER_REDACT=strict has collapsed it everywhere else.
# It accumulates across runs and across workers; it is not replaced per run.
#
# It is written to your project root by default, and it holds page content. Add it
# to .gitignore, or move it somewhere outside the repository:
# HEALING_RECORDS_PATH=../healer-artifacts/healing-records.json

# Records kept, newest first. The file is read, merged and rewritten on every heal, so
# this sets a permanent per-heal cost — measured at 14ms for 1000 records and 117ms for
# 10000. Raise it only if you actually mine this file. 0 keeps everything, which is
# NOT the same as switching it off.
# HEALER_RECORDS_MAX=1000

# Switch the file off entirely. Heals are still annotated, attached, gated in CI and
# summarised by the reporter — the only thing lost is the unredacted rewrite above.
# HEALER_RECORDS=true

# --- CI gate ---------------------------------------------------------------
#
# Fail a test that only passed because a selector was healed. A heal means the
# test no longer matches the application: if that is a redesign you want the
# rewrite, but if someone deleted the button and the model found a plausible
# substitute, a green suite hides the regression.
#
# Healing still runs, so one run reports EVERY stale selector rather than
# stopping at the first, and each failure message carries the exact edits.
#
# Recommended for CI, not for local work. Set it in your CI environment rather than
# here — this file is for your machine, and dotenv does NOT expand ${VAR}, so writing
# HEALER_FAIL_ON_HEAL=${CI} on the next line stores the literal characters "${CI}",
# which is not a boolean and switches healing off entirely.
#
#   GitHub Actions   env:  HEALER_FAIL_ON_HEAL: true
#   GitLab CI        variables:  HEALER_FAIL_ON_HEAL: "true"
#   any shell        HEALER_FAIL_ON_HEAL=true npx playwright test
#
# HEALER_FAIL_ON_HEAL=false

# --- Is the healed element the RIGHT one? ----------------------------------
#
# A suggestion that resolves to one visible element is not necessarily the
# element the test meant. On a page with "Place order" and "Cancel", both are
# unique and clickable, so a heal onto Cancel passes every other gate and the
# suite goes green having tested the wrong path.

# off | warn | enforce                (default: enforce)
#   off      accept any suggestion that resolves to one visible element
#   warn     run every check, record and annotate concerns, heal anyway.
#            Use this to adopt the checks on an existing suite without
#            turning it red on day one.
#   enforce  a failed check rejects the suggestion and the reason is fed into
#            the next attempt
HEALER_INTENT_CHECK=enforce

# Confidence required when NOTHING about a heal can be verified — an opaque
# selector like #btn-1 with no describe(), where no check has any signal to
# work with. Those are the heals most likely to be wrong, so the bar rises.
# Adding describe() to your locators is the better fix.
# HEALER_UNVERIFIED_CONFIDENCE=0.9

# --- Privacy: what may leave the machine -----------------------------------
#
# Healing describes the page to a third-party model, so whatever is on screen is
# what gets sent. Read the "What is transmitted" section of README.md before
# pointing this at an application holding real data.

# off | identifiers | strict          (default: identifiers)
#   off          send the page snapshot unchanged. Disables the BUILT-IN rules only;
#                a patterns file and a redactor callback still apply.
#   identifiers  strip emails, card/SSN-shaped numbers, GUIDs, tokens, long
#                account numbers, dates and postcodes; drop URL query strings.
#                CANNOT catch names or free text — no regex can.
#   strict       also collapse the accessible name of every element you cannot
#                act on, and the value of every element you can. Catches names
#                and free text, at some cost to healing on text-heavy pages.
HEALER_REDACT=identifiers

# Scope the snapshot to one container instead of the whole page. The cheapest
# control available: it reduces what is captured AND the token bill.
# A configured root is never exceeded: on a page where the selector does not
# resolve, the heal is blocked rather than capturing the whole page. So only set
# this to a container your pages actually share.
# HEALER_SNAPSHOT_ROOT=#checkout-form

# Origins cleared for healing. When set, this is an ALLOWLIST — healing is
# refused everywhere else, including routes nobody thought to enumerate. Entries
# are full origins or hosts, and may lead with `*.` for subdomains.
# HEALER_ALLOWED_ORIGINS=https://staging.example.com,*.test.internal

# Paths healing never runs on, whatever the origin. Takes precedence over the
# allowlist, so a cleared application can still exclude its record pages.
# Supports ?, * and **; a trailing /** also matches the bare prefix.
# HEALER_BLOCKED_PATHS=/patients/**,/claims/**,/admin/**

# Extra redaction patterns, as a JSON array of regex strings (or objects with
# "pattern" and "flags"). Applied after the built-in set.
# HEALER_REDACT_PATTERNS_FILE=./redact-patterns.json

# Write the exact payload each heal WOULD send into this directory and call no
# provider. Needs no API key, costs nothing, and no heal can succeed while it is
# set — the point is to read what would leave, not to heal.
# HEALER_PRIVACY_PREVIEW=./privacy-preview

# --- Anthropic (default provider) -----------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# --- OpenAI (set HEALER_PROVIDER=openai to use) ----------------------------
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# Point at Azure OpenAI, a gateway, or any Chat Completions-compatible server
# (including an OpenAI-compatible Ollama endpoint):
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Gemini (set HEALER_PROVIDER=gemini to use) ----------------------------
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- Ollama (not implemented yet; see notes in TestWrapper.createProvider) --
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# --- Playwright ------------------------------------------------------------
# chromium | firefox | webkit
BROWSER=chromium
HEADLESS=true
# true forces a headed run regardless of HEADLESS
SHOW_BROWSER=false

# --- Logging ---------------------------------------------------------------
# error | warn | info | debug
LOG_LEVEL=info

# Silences the healer's own per-heal narration — "Attempt 1/2", "Healed X -> Y",
# "Reused from cache" — without turning LOG_LEVEL down for everything else. A suite
# that heals fifty times otherwise produces fifty lines nobody reads.
# Warnings and errors still get through, and records are never affected.
HEALING_LOGS=true
